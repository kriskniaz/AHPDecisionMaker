@model AHPDecisionMaker.Web.ViewModels.ProjectCreateEditViewModel
@{
    ViewData["Title"] = "New Project";
}

<div class="breadcrumb">
    <a asp-action="Index">Projects</a>
    <span class="sep">/</span>
    <span class="current">New Project</span>
</div>

<div class="page-header">
    <h1>New <span>Project</span></h1>
</div>

<div class="card" style="max-width: 640px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Goal" class="form-label"></label>
            <input asp-for="Goal" class="form-control" placeholder="e.g. Selection of best automobile" autocomplete="off" />
            <span asp-validation-for="Goal" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"
                      placeholder="Optional: additional context about the decision..."></textarea>
            <span asp-validation-for="Description" class="field-validation-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Project</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
