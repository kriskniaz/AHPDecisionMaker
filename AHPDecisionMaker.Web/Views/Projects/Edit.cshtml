@model AHPDecisionMaker.Web.ViewModels.ProjectCreateEditViewModel
@{
    ViewData["Title"] = "Edit Project";
}

<div class="breadcrumb">
    <a asp-action="Index">Projects</a>
    <span class="sep">/</span>
    <span class="current">@Model.Goal</span>
</div>

<div class="page-header d-flex align-center gap-12" style="justify-content: space-between; flex-wrap: wrap;">
    <div>
        <h1>Edit <span>Project</span></h1>
    </div>
    <div>
        @if (Model.ModelId.HasValue)
        {
            <a asp-controller="Models" asp-action="Edit" asp-route-id="@Model.ModelId" class="model-badge has-model">
                ◈ Decision Model
            </a>
        }
        else
        {
            <form asp-controller="Models" asp-action="CreateForProject" method="post" style="display: inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@Model.ProjectId" />
                <button type="submit" class="model-badge">+ Add Decision Model</button>
            </form>
        }
    </div>
</div>

<div class="card" style="max-width: 640px;">
    <form asp-action="Edit" asp-route-id="@Model.ProjectId" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ProjectId" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Goal" class="form-label"></label>
            <input asp-for="Goal" class="form-control" autocomplete="off" />
            <span asp-validation-for="Goal" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="field-validation-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary">Back to Projects</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
